# ============================================================
#  哈希表（线性探测法）Makefile
#  Hash Table (Linear Probing) Makefile
# ============================================================

# 默认构建目标：当只输入 `make` 时，构建 DS_HTL
# Default goal: build DS_HTL when just typing `make`
.DEFAULT_GOAL := DS_HTL

# -----------------------------------------------------------
# 编译器与编译选项
# Compiler and flags
# -----------------------------------------------------------
CC       := gcc
CFLAGS   := -Wall -Wextra -std=c11
LDFLAGS  := -lm          # 链接数学库 (-lm for math.h, e.g., ceil)

# -----------------------------------------------------------
# 目标文件列表
# Object files to be compiled
# -----------------------------------------------------------
# 核心实现文件
SRCS     := hash_table_linear.c
# 测试文件
TEST_SRC := test.c
# 所有 .o 目标文件
OBJS     := $(SRCS:.c=.o) $(TEST_SRC:.c=.o)
# 可执行文件名
TARGET   := DS_HTL

# -----------------------------------------------------------
# 隐式规则：将 .c 编译为 .o
# Implicit rule: compile .c -> .o
#   $< : 第一个依赖（即对应的 .c 文件）
#   $@ : 目标（即生成的 .o 文件）
# -----------------------------------------------------------
%.o : %.c
	$(CC) $(CFLAGS) -c $< -o $@

# -----------------------------------------------------------
# 链接规则：将目标文件链接为可执行文件
# Link rule: link all .o into final executable
#   $^ : 所有依赖文件
#   $@ : 目标文件
# -----------------------------------------------------------
$(TARGET) : $(OBJS)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

# -----------------------------------------------------------
# 伪目标，避免与同名文件冲突
# .PHONY prevents conflict with files of the same name
# -----------------------------------------------------------
.PHONY : clean run

# -----------------------------------------------------------
# run  : 先编译，后运行
# run  : build first, then execute
# -----------------------------------------------------------
run : $(TARGET)
	@echo "====================================="
	@echo "  Running $(TARGET) ..."
	@echo "====================================="
	./$(TARGET)

# -----------------------------------------------------------
# clean: 清理编译产物（二进制 + 目标文件）
# clean: remove executable and object files
#   -  前缀表示忽略删除失败的错误（如文件不存在）
#   -  prefix suppresses error when file does not exist
# -----------------------------------------------------------
clean :
	-rm -rf $(TARGET)
	-rm -rf $(OBJS)
	@echo "Clean complete."